{
  "info": {
    "name": "VLTS-RBAC Full Suite-7Feb",
    "_postman_id": "nuatnnvasys-rbac-full-suite",
    "description": "Collection for testing Super Admin, Tenant Admin, Tenant User authentication and tenant lifecycle APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Super Admin Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "http://localhost:3006/api/auth/superadmin/login" },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"suresh.gupta@nutantek.com\",\n  \"password\": \"nutan123\"\n}"
        }
      }
    },
    {
      "name": "Super Admin Refresh Token",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "http://localhost:3006/api/auth/superadmin/refresh" },
        "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{superadmin_refresh}}\"\n}" }
      }
    },
    {
      "name": "Super Admin Logout",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{superadmin_token}}" }],
        "url": { "raw": "http://localhost:3006/api/auth/superadmin/logout" }
      }
    },
    {
      "name": "Super Admin Create Tenant",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{superadmin_token}}" }
        ],
        "url": { "raw": "http://localhost:3006/api/platform/tenants" },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenant_id\": \"TENANT001\",\n  \"name\": \"DemoTenant\",\n  \"domain\": \"demo.tenant.com\",\n  \"admin_email\": \"tenantadmin@demo.com\",\n  \"admin_password\": \"ChangeMe123!\"\n}"
        }
      }
    },
    {
      "name": "Super Admin Get Tenants",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{superadmin_token}}" }],
        "url": { "raw": "http://localhost:3006/api/platform/tenants" }
      }
    },
    {
