          { "key": "Authorization", "value": "Bearer {{superadmin_token}}" }
        ],
        "url": { "raw": "http://localhost:3006/api/platform/tenants/{{tenant_id}}" },
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"UpdatedTenantName\"\n}" }
      }
    },
    {
      "name": "Super Admin Delete Tenant",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{superadmin_token}}" }],
        "url": { "raw": "http://localhost:3006/api/platform/tenants/{{tenant_id}}" }
